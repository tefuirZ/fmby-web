{
  "name": "fmby-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @fmby/v2-host dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @fmby/v2-host build",
    "build:themes": "pnpm -r --filter './themes/*' build",
    "preview": "pnpm --filter @fmby/v2-host preview",
    "repo-size": "node scripts/check-repo-size.mjs",
    "size": "node scripts/check-frontend-size.mjs",
    "dupes": "node scripts/check-frontend-dupes.mjs",
    "contracts": "node scripts/check-contract-mappers.mjs",
    "e2e": "pnpm --filter @fmby/v2-host test:e2e",
    "verify": "pnpm versions && pnpm typecheck && pnpm build && pnpm build:themes && pnpm test && pnpm size && pnpm repo-size && pnpm dupes && pnpm contracts && pnpm theme-budget && pnpm theme-parity",
    "versions": "node scripts/check-versions.mjs",
    "theme-budget": "node scripts/check-theme-budget.mjs",
    "theme-parity": "node scripts/check-theme-parity.mjs",
    "test": "pnpm -r test"
  }
}
