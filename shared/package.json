{
  "name": "@fmby/v2-shared",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "description": "FMBY v2 前端共享层（唯一）：contracts(DTO+mapper) / api client / query keys / 错误模型 / Asia-Shanghai 时间 / 主题协议 / UI 基座。见 docs/09-webui.md §2。",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./api/*": "./src/api/*",
    "./contracts": "./src/contracts/index.ts",
    "./contracts/*": "./src/contracts/*",
    "./query": "./src/query/index.ts",
    "./query/*": "./src/query/*",
    "./errors": "./src/errors/index.ts",
    "./errors/*": "./src/errors/*",
    "./time": "./src/time/index.ts",
    "./theme": "./src/theme/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/*": "./src/ui/*",
    "./forms": "./src/forms/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*",
    "./search": "./src/search/index.ts",
    "./search/*": "./src/search/*",
    "./utils/*": "./src/utils/*",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "pinyin-pro": "^3.28.1"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-checkbox": "^1.1.8",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.7",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.1.14",
    "@tanstack/react-query": "^5.75.5",
    "lucide-react": "^0.513.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "typescript": "^5.8.3"
  }
}
