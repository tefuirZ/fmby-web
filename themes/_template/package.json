{
  "name": "@fmby/v2-theme-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "主题模板（themes/_template）：第三方主题完整样板。灰蓝画布 token 集 + 一个真实可用的 browse.item L3 皮肤（编辑档案版式，五态全覆盖/响应式/实时/导航），作为「从零做主题」的起手工程。",
  "exports": {
    ".": "./src/index.ts",
    "./theme.manifest.json": "./theme.manifest.json",
    "./tokens.css": "./tokens.css",
    "./skins/item.css": "./skins/item.css"
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import ../../shared/tests/register-resolver.mjs --test tests/*.test.ts",
    "build": "vite build && node -e \"const fs=require('fs');const cp=(s,d)=>{fs.copyFileSync(s,d)};['theme.manifest.json','tokens.css','aurora.css'].forEach(f=>{if(fs.existsSync(f))cp(f,'dist/'+f)});if(fs.existsSync('skins'))fs.mkdirSync('dist/skins',{recursive:true}),fs.readdirSync('skins').forEach(f=>cp('skins/'+f,'dist/skins/'+f))\""
  },
  "devDependencies": {
    "@fmby/v2-shared": "workspace:*",
    "typescript": "^5.8.3",
    "react": "^19.1.0",
    "@types/react": "^19.1.4",
    "react-dom": "^19.1.0",
    "@types/react-dom": "^19.1.4",
    "vite": "^6.3.5"
  }
}
